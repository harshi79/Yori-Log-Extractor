# ---------------------------------------------------------------------------
# Yori Log Extractor — copy this file to .env and fill in the two secrets.
#   cp .env.example .env
# ---------------------------------------------------------------------------

# 1) Telegram bot token — talk to @BotFather, /newbot, copy the whole line.
TELEGRAM_BOT_TOKEN=123456789:AAExampleTokenFromBotFather

# 2) MantisBin API key — sign in at https://mantisbin.yorichii.workers.dev/me
#    and create a key. It is shown once; it starts with "mb_".
MANTISBIN_API_KEY=mb_ExampleKeyFromMantisBin

# ---------------------------------------------------------------------------
# Optional settings — the defaults are already what most people want.
# ---------------------------------------------------------------------------

# MantisBin instance to talk to (change only if you self-host it).
#MANTISBIN_BASE_URL=https://mantisbin.yorichii.workers.dev

# Paste lifetime for every paste the bot creates: never | 10m | 1h | 6h | 1d | 1w | 1mo | 1y
MANTISBIN_EXPIRY=never

# Title prefix, so bot pastes are easy to spot in your MantisBin account.
#MANTISBIN_TITLE_PREFIX=Yori Logs

# Who may create pastes:
#   anyone  — anybody who finds the bot (default)
#   owner   — only BOT_OWNER_ID
#BOT_ACCESS=anyone
#BOT_OWNER_ID=123456789

# Or keep "anyone" but limit it to a few people (comma separated numeric ids).
# Get an id by sending /id to the bot. "any" or "off" disables the list.
#BOT_ALLOWED_USERS=123456789,987654321

# Refuse files bigger than this many MB. MantisBin's own limits are 10 MB with
# an API key and 5 MB anonymously; Telegram also caps bot downloads at 20 MB.
#MAX_FILE_MB=10

# Typed-out text shorter than this is answered with a hint instead of a paste
# (send it with the #paste prefix to store it anyway). 0 disables the floor.
#MIN_TEXT_CHARS=500

# Seconds to wait on a MantisBin request before giving up.
#HTTP_TIMEOUT=30
